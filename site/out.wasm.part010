                                  \ utmp_runas
                                  \ visiblepw

syn keyword sudoersIntegerParameter contained
                                  \ nextgroup=sudoersIntegerParameterEquals
                                  \ skipwhite skipnl
                                  \ closefrom
                                  \ command_timeout
                                  \ loglinelen
                                  \ maxseq
                                  \ passwd_timeout
                                  \ passwd_tries
                                  \ syslog_maxlen
                                  \ timestamp_timeout
