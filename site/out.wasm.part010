   call s:Accents('E','Ãˆ','Ã‰','ÃŠ','Ã‹','áº¼','Ä–','Ä’','È¨',' ','Ä˜',' ','Ä”','Äš')
   call s:Accents('g',' ','Çµ','Ä',' ',' ','Ä¡',' ','Ä£',' ',' ',' ','ÄŸ','Ç§')
