                  \ ['AUDIO', 'MODE1', 'MODE1_RAW', 'MODE2', 'MODE2_FORM1',
                  \  'MODE2_FORM2', 'MODE2_FORM_MIX', 'MODE2_RAW'])

call s:def_keywords('cdrtocTrackSubTrackZeroDataSubChannelMode',
