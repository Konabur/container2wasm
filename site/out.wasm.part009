                                  \ contains=@etermGeneral,etermEScreenOptions

if exists("eterm_minlines")
  let b:eterm_minlines = eterm_minlines
else
  let b:eterm_minlines = 50
endif
exec "syn sync minlines=" . b:eterm_minlines

