                  \ ['RW', 'RW_RAW'])

call s:def_match('cdrtocTrackSubTrackZeroDataLength',
               \ '@cdrtocTrackContentsFollow',
               \ s:length_pattern)

call s:def_keyword('cdrtocTrackMarker',
